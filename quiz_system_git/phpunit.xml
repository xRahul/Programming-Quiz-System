<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <!--
      Test-process credential defaults. <env> without force="true" only sets
      a variable when it is not already defined, so shell exports (and CI
      secrets) take precedence over these values. Tests needing a live
      database skip gracefully when DB_PASS is empty. See CONTRIBUTING.md and
      setup-remove.md.
    -->
    <php>
        <env name="DB_USER" value="quiz"/>
        <env name="DB_PASS" value=""/>
    </php>
</phpunit>
