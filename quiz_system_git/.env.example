# Copy to `.env` and fill in real values; then export the variables in your
# shell (e.g. `set -a; source .env; set +a`). lib/config.php reads them via
# getenv(). Never commit a real .env.
#
# DB_NAME defaults to the legacy seed database; import
# database/debug-v2.sql into it for a working dataset.
DB_HOST=localhost
DB_NAME=debug
DB_USER=quiz
DB_PASS=
APP_ENV=production
